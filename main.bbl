      \field{shorttitle}{Strontium Isotope ({{87Sr}}/{{86Sr}}) Variability in the {{Nile Valley}}}
      \field{title}{Strontium Isotope ({{87Sr}}/{{86Sr}}) Variability in the {{Nile Valley}}: {{Identifying}} Residential Mobility during Ancient {{Egyptian}} and {{Nubian}} Sociopolitical Changes in the {{New Kingdom}} and {{Napatan}} Periods}
