      \field{journaltitle}{HOMO}
      \field{number}{4}
      \field{shortjournal}{HOMO}
      \field{shorttitle}{Illuminating the {{Nubian}} ‘{{Dark Age}}’}
      \field{title}{Illuminating the {{Nubian}} ‘{{Dark Age}}’: {{A}} Bioarchaeological Analysis of Dental Non-Metric Traits during the {{Napatan Period}}}
